---
// The scroll-driven soulsystem story. Seven always-visible steps in document
// order (the no-JS/crawler rendering IS the content); an IntersectionObserver
// sets data-focus on the root, and CSS does the rest. The map zoom is a
// precomputed translate–scale–translate on the SVG's .world group — no
// runtime math, no dependencies.
import { getCollection, render } from 'astro:content';
import SoulMap from './SoulMap.astro';
import { BODIES, VIEW, focusVars } from '../../data/soulsystem';

const entries = (await getCollection('story')).sort((a, b) => a.data.order - b.data.order);
const steps = await Promise.all(
  entries.map(async (e) => ({ ...e.data, Content: (await render(e)).Content })),
);
const bodyById = new Map(BODIES.map((b) => [b.id, b]));
const vars = [
  `--vcx: ${VIEW.cx}px`,
  `--vcy: ${VIEW.cy}px`,
  ...BODIES.map(focusVars),
].join('; ');
---
<section class="story" data-focus="overview" style={vars} aria-label="the soulsystem, explained">
  <figure class="story__map">
    <SoulMap mode="story" />
    {/* narrow screens drop the in-map labels (they collide once they are big
        enough to read) and name the focused body here instead */}
    <figcaption class="story__now" aria-hidden="true">
      <span data-for="overview">the soulsystem · five bodies</span>
      {BODIES.map((b) => (
        <span data-for={b.id}><b style={`color: var(--${b.hue})`}>{b.name}</b> · {b.role}</span>
      ))}
      <span data-for="all">five bodies · one record</span>
    </figcaption>
  </figure>
  <div class="story__steps">
    {steps.map((s) => {
      const body = bodyById.get(s.step);
      return (
        <section class="step" id={`step-${s.step}`} data-step={s.step}>
          <p class="eyebrow" style={body ? `color: var(--${body.hue})` : undefined}>{s.eyebrow}</p>
          <h2>{s.title}</h2>
          <div class="step__body">
            <s.Content />
          </div>
          {body && (
            <p class="step__meta">
              <span class="st"><i style={`color: var(--${body.hue})`}>{body.version}</i> · {body.status}</span>
              <a class="src" style={`color: var(--${body.hue})`} href={body.repo}>code →</a>
            </p>
          )}
          {s.step === 'all' && (
            <p class="step__cta">
              <a class="enter enter--solid" href="/soulstream/get-started/">Get started →</a>
              <a class="enter" href="/soulstream/">Start with the record →</a>
              <a class="enter" href="/soulsystem/">Study the map →</a>
            </p>
          )}
        </section>
      );
    })}
  </div>
</section>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 60%) minmax(0, 1fr);
    gap: 48px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 28px;
  }
  .story__map {
    position: sticky;
    top: var(--nav-h);
    height: min(84vh, 680px);
    align-self: start;
    margin: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  /* the map must fill the frame. As a flex item it collapsed to the SVG's
     intrinsic 300px — a fixed-size drawing at every viewport, which is why it
     read tiny; sizing both axes hands the scaling back to the viewBox. */
  .story__map :global(.map) {
    margin: 0;
    width: 100%;
    height: 100%;
  }
  .story__map :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .step {
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    scroll-margin-top: var(--nav-h);
  }
  .step h2 {
    margin: 0 0 14px;
    font-size: clamp(1.6rem, 3vw, 2.15rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-weight: 620;
    text-wrap: balance;
  }
  .step .eyebrow { margin-bottom: 12px; }
  .step__body :global(p) { margin: 0 0 14px; color: var(--ink-dim); }
  .step__body :global(p b), .step__body :global(p strong) { color: var(--ink); font-weight: 600; }
  .step__body :global(pre) {
    margin: 0 0 14px; padding: 13px 16px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    font: 0.85rem/1.5 var(--mono);
    overflow-x: auto;
  }
  .step__body :global(code) { font-family: var(--mono); font-size: 0.9em; }
  .step__meta {
    margin: 4px 0 0;
    font: 0.74rem var(--mono);
    color: var(--ink-faint);
    letter-spacing: 0.04em;
    display: flex; gap: 16px; align-items: baseline;
  }
  .step__meta i { font-style: normal; }
  .step__meta .src { font-weight: 600; text-decoration: none; }
  .step__meta .src:hover { text-decoration: underline; text-underline-offset: 3px; }
  .step__cta { display: flex; gap: 12px; flex-wrap: wrap; margin: 18px 0 0; }

  .story__now { display: none; }
  .story__now span { display: none; }
  .story__now b { font-weight: 650; }

  @media (max-width: 900px) {
    .story { display: block; max-width: 720px; }
    .story__map {
      top: 0;
      z-index: 2;
      /* full-bleed: on a phone the map wants every pixel it can get */
      width: calc(100% + 56px);
      margin-inline: -28px;
      height: clamp(230px, 44svh, 380px);
      grid-template-rows: minmax(0, 1fr) auto;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 10px 18px -14px rgb(27 31 44 / 0.4);
    }
    .story__map :global(.map) { min-height: 0; }
    .story__now {
      display: block;
      padding: 0 18px 8px;
      font: 0.74rem var(--mono);
      letter-spacing: 0.04em;
      color: var(--ink-faint);
      text-align: center;
    }
    .step { min-height: 78svh; padding-top: 10px; }

    .story[data-focus='overview'] .story__now span[data-for='overview'],
    .story[data-focus='soulstream'] .story__now span[data-for='soulstream'],
    .story[data-focus='soulidentity'] .story__now span[data-for='soulidentity'],
    .story[data-focus='soulrealm'] .story__now span[data-for='soulrealm'],
    .story[data-focus='soulfold'] .story__now span[data-for='soulfold'],
    .story[data-focus='soulnode'] .story__now span[data-for='soulnode'],
    .story[data-focus='all'] .story__now span[data-for='all'] { display: inline; }
  }
  @media (max-height: 500px) {
    .story__map { position: static; height: auto; }
  }
</style>

<style is:global>
  /* ---- the story's state machine (global: it reaches into the map SVG) ---- */

  /* One transform rule; a focus step only swaps --z/--fx/--fy (from
     src/data/soulsystem.ts). --zb is the narrow-screen zoom boost: a phone
     shows the same schematic in fewer pixels, so it leans in harder. */
  .story .world {
    transform: translate(var(--vcx), var(--vcy))
      scale(calc(var(--z, 1) * var(--zb, 1)))
      translate(calc(var(--fx, var(--vcx)) * -1), calc(var(--fy, var(--vcy)) * -1));
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .story[data-focus='soulstream'] .world {
    --z: var(--z-soulstream); --fx: var(--fx-soulstream); --fy: var(--fy-soulstream);
  }
  .story[data-focus='soulidentity'] .world {
    --z: var(--z-soulidentity); --fx: var(--fx-soulidentity); --fy: var(--fy-soulidentity);
  }
  .story[data-focus='soulrealm'] .world {
    --z: var(--z-soulrealm); --fx: var(--fx-soulrealm); --fy: var(--fy-soulrealm);
  }
  .story[data-focus='soulfold'] .world {
    --z: var(--z-soulfold); --fx: var(--fx-soulfold); --fy: var(--fy-soulfold);
  }
  .story[data-focus='soulnode'] .world {
    --z: var(--z-soulnode); --fx: var(--fx-soulnode); --fy: var(--fy-soulnode);
  }

  .story .body, .story .orbits ellipse { transition: opacity 0.35s; }
  .story .lbl-name, .story .lbl-role { transition: opacity 0.35s; }
  .story .lbl-name { font-size: 17px; }
  .story .lbl-role { font-size: 11.5px; }

  /* while a body is focused: labels off, others dimmed, orbits faded */
  .story:not([data-focus='overview']):not([data-focus='all']) :is(.lbl-name, .lbl-role) { opacity: 0; }
  .story:not([data-focus='overview']):not([data-focus='all']) .orbits ellipse { opacity: 0.2; }
  .story[data-focus='soulstream'] .body:not(.body--soulstream),
  .story[data-focus='soulidentity'] .body:not(.body--soulidentity),
  .story[data-focus='soulrealm'] .body:not(.body--soulrealm),
  .story[data-focus='soulfold'] .body:not(.body--soulfold) { opacity: 0.15; }
  /* the house keeps the system in frame — dim gently, it is gathering them */
  .story[data-focus='soulnode'] .body:not(.body--soulnode) { opacity: 0.45; }

  /* ---- the per-step schematics (MapDetails.astro) ---- */
  .story .detail { opacity: 0; transition: opacity 0.4s ease 0.15s; }
  .story[data-focus='soulstream'] .detail--soulstream,
  .story[data-focus='soulidentity'] .detail--soulidentity,
  .story[data-focus='soulrealm'] .detail--soulrealm,
  .story[data-focus='soulfold'] .detail--soulfold,
  .story[data-focus='soulnode'] .detail--soulnode { opacity: 1; }
  /* the schematic draws its body's own nodes; the halo stays as a glow behind
     it, pulled back so it lights the drawing instead of washing it out */
  .story .body .core, .story .body .halo { transition: opacity 0.3s; }
  .story[data-focus='soulstream'] .body--soulstream .core,
  .story[data-focus='soulidentity'] .body--soulidentity .core,
  .story[data-focus='soulrealm'] .body--soulrealm .core,
  .story[data-focus='soulfold'] .body--soulfold .core { opacity: 0; }
  .story[data-focus='soulstream'] .body--soulstream .halo,
  .story[data-focus='soulidentity'] .body--soulidentity .halo,
  .story[data-focus='soulrealm'] .body--soulrealm .halo,
  .story[data-focus='soulfold'] .body--soulfold .halo,
  .story[data-focus='soulnode'] .body--soulnode .halo { opacity: 0.22; }

  @media (max-width: 900px) {
    /* big enough to read is big enough to collide: the caption under the map
       carries the name instead, and focused steps zoom harder */
    .story .lbl-name, .story .lbl-role { display: none; }
    .story .world { --zb: 1.2; }
    .story:not([data-focus='overview']):not([data-focus='all']) .world { --zb: 1.35; }
  }

  .story .gather line { transition: opacity 0.5s, stroke-dashoffset 0.9s ease 0.15s; }
  .story[data-focus='soulnode'] .gather line { opacity: 0.85; stroke-dashoffset: 0; }
  .story[data-focus='all'] .gather line { opacity: 0.3; stroke-dashoffset: 0; }

  /* step dimming exists only once JS arrives; without it nothing is dimmed */
  .story--enhanced .step { opacity: 0.4; transition: opacity 0.3s; }
  .story--enhanced .step.is-active { opacity: 1; }

  /* reduced motion: every state still lands — a step's schematic is the
     content, and dropping the zoom would leave it unreadable — but it lands
     instantly, with nothing animating, panning, or drawing on */
  .story--reduced .world, .story--reduced .body, .story--reduced .orbits ellipse,
  .story--reduced .lbl-name, .story--reduced .lbl-role,
  .story--reduced .detail, .story--reduced .body .core,
  .story--reduced .step { transition: none !important; }
  .story--reduced .gather line { transition: none !important; stroke-dasharray: none; }
  @media (prefers-reduced-motion: reduce) {
    .story .world, .story .body, .story .orbits ellipse,
    .story .lbl-name, .story .lbl-role,
    .story .detail, .story .body .core,
    .story .step { transition: none !important; }
    .story .gather line { transition: none !important; stroke-dasharray: none; }
  }
</style>

<script>
  const story = document.querySelector<HTMLElement>('.story');
  if (story) {
    story.classList.add('story--enhanced');
    const steps = Array.from(story.querySelectorAll<HTMLElement>('.step'));
    const setFocus = (id: string) => {
      story.dataset.focus = id;
      steps.forEach((s) => s.classList.toggle('is-active', s.dataset.step === id));
    };

    // arriving mid-page (reload, anchor): focus the step nearest center
    const mid = window.innerHeight / 2;
    let best = steps[0];
    let bestD = Infinity;
    for (const s of steps) {
      const r = s.getBoundingClientRect();
      const d = Math.abs((r.top + r.bottom) / 2 - mid);
      if (d < bestD) { bestD = d; best = s; }
    }
    setFocus(best.dataset.step!);

    // a step activates when it crosses the vertical center band; last-known
    // focus persists between steps so the map never snaps to a null state
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) setFocus((e.target as HTMLElement).dataset.step!);
        }
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
    );
    steps.forEach((s) => io.observe(s));

    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const applyMotion = () => story.classList.toggle('story--reduced', mq.matches);
    applyMotion();
    mq.addEventListener('change', applyMotion);

    // one completion event, only where the counter exists (production)
    const last = steps[steps.length - 1];
    let completed = false;
    const done = new IntersectionObserver((entries) => {
      if (completed || !entries.some((e) => e.isIntersecting)) return;
      completed = true;
      done.disconnect();
      (window as any).goatcounter?.count?.({
        path: 'soulsystem-story-completed',
        title: 'soulsystem story completed',
        event: true,
      });
    });
    done.observe(last);
  }
</script>
