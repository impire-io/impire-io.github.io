---
interface Props {
  /** which top-level section is current: 'soulstream' | 'pra' | 'imps' | 'about' */
  active?: string;
}
const { active } = Astro.props;
const link = (href: string, label: string, key: string) => ({ href, label, key });
// the two things people arrive for, then the third project, then the person
const links = [
  link('/soulstream/', 'soulstream', 'soulstream'),
  link('/pra/', 'pra', 'pra'),
  link('/imps/', 'imps', 'imps'),
  link('/about/', 'about', 'about'),
];
---
<nav class="nav" aria-label="impire sections">
  <a class="wordmark" href="/"><b>impire</b><span class="tld">.io</span>
    <span class="dots" aria-hidden="true">
      <i style="background:var(--soulstream-bright)"></i><i style="background:var(--soulidentity-bright)"></i><i style="background:var(--soulrealm-bright)"></i><i style="background:var(--soulfold-bright)"></i><i style="background:var(--soulnode-bright)"></i>
    </span>
  </a>
  <span class="links">
    {links.map((l) => (
      <a href={l.href} data-p={l.key} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>
    ))}
  </span>
</nav>
