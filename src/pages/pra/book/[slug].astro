---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { article } from '../../../lib/jsonld';

export async function getStaticPaths() {
  const entries = (await getCollection('book')).sort((a, b) => a.data.order - b.data.order);
  const chapters = entries.filter((e) => e.data.kind === 'chapter');
  return entries.map((entry) => {
    const i = entries.indexOf(entry);
    const label = (e: typeof entry) =>
      e.data.kind === 'glossary' ? 'Glossary' : `${e.data.num} · ${e.data.title}`;
    return {
      params: { slug: entry.id },
      props: {
        entry,
        chapterCount: chapters.length,
        prev: i > 0 ? { href: `./${entries[i - 1].id}.html`, label: label(entries[i - 1]) } : null,
        next: i < entries.length - 1 ? { href: `./${entries[i + 1].id}.html`, label: label(entries[i + 1]) } : null,
      },
    };
  });
}

const { entry, chapterCount, prev, next } = Astro.props;
const { Content } = await render(entry);
const isGlossary = entry.data.kind === 'glossary';
const sourceUrl = `https://github.com/impire-io/poseres/blob/main/book/${entry.data.src}`;
const title = isGlossary
  ? 'Glossary — the PRA book'
  : `${entry.data.num} · ${entry.data.title} — the PRA book`;
const description = isGlossary
  ? 'Every plain-words definition from the PRA book, in order of appearance.'
  : `Chapter ${entry.data.num} of the PRA book, published as a draft: ${entry.data.title}.`;
---
<BaseLayout
  title={title}
  description={description}
  project="pra"
  active="research"
  ogType="article"
  ogImage="book.png"
  schema={[article({ headline: title, description, url: new URL(Astro.url.pathname, Astro.site).href })]}
  noFooter
>
  <main class="book">
    <header class="book-head">
      <p class="eyebrow"><a href="/pra/book/">the pra book</a> · {isGlossary ? 'reference' : entry.data.part.toLowerCase()}</p>
      {!isGlossary && <p class="book-part">chapter {entry.data.num} of {chapterCount}</p>}
      <h1>{entry.data.title}</h1>
      <p class="book-draftnote">
        draft · the numbers audit has not run yet —
        <a href="/pra/book/#draft">read measured numbers as provisional</a>
      </p>
    </header>

    <article class="book-prose">
      <Content />
    </article>

    <nav class="book-pager" aria-label="book pages">
      {prev && <a class="prev" href={prev.href}><span>previous</span>{prev.label}</a>}
      {next && <a class="next" href={next.href}><span>next</span>{next.label}</a>}
    </nav>
  </main>

  <footer>
    <div class="cols">
      <div>
        <p>
          {isGlossary ? 'The glossary of' : 'A chapter of'} the PRA book, published as a
          draft. Its source is <a href={sourceUrl}>book/{entry.data.src}</a> in the PRA
          repository.
        </p>
        <p><a href="/pra/">← pra</a> · <a href="/pra/book/">book contents</a></p>
      </div>
      <div class="meta">
        <span>impire.io/pra · no cookies · privacy-friendly stats by <a href="https://impire.goatcounter.com">GoatCounter</a></span>
      </div>
    </div>
  </footer>
</BaseLayout>
